              "name": "emailBody",
              "value": "=<html>\n<body style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n  <h2 style=\"color: #333;\">New Video Ready for Approval</h2>\n  \n  <div style=\"background: #f5f5f5; padding: 20px; border-radius: 8px; margin: 20px 0;\">\n    <p><strong>Title:</strong> {{ $('Prepare Video Parameters').item.json.videoTitle }}</p>\n    <p><strong>Description:</strong> {{ $('Prepare Video Parameters').item.json.videoDescription }}</p>\n    <p><strong>Target Platforms:</strong> {{ $('Prepare Video Parameters').item.json.platforms }}</p>\n    <p><strong>Aspect Ratio:</strong> {{ $('Prepare Video Parameters').item.json.aspectRatio }}</p>\n    <p><strong>Resolution:</strong> {{ $('Prepare Video Parameters').item.json.resolution }}</p>\n  </div>\n  \n  <div style=\"margin: 20px 0; padding: 15px; background: #e8f4e8; border-radius: 8px;\">\n    <p><strong>Video Preview:</strong></p>\n    <a href=\"{{ $json.video.url }}\" style=\"color: #007bff; font-size: 16px;\">Click here to preview video</a>\n  </div>\n  \n  <p style=\"color: #666; font-size: 12px;\">Generation took {{ Math.round($json.duration / 1000) }} seconds</p>\n  <p style=\"color: #666; font-size: 12px;\">Request ID: {{ $json.requestId }}</p>\n</body>\n</html>",
